# Runtime
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://baseline:baseline@localhost:5432/baseline
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Model providers (optional; the product runs in deterministic demo mode without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash

# Approximate input/output prices per million tokens. Override as pricing changes.
OPENAI_INPUT_PRICE=2.00
OPENAI_OUTPUT_PRICE=12.00
ANTHROPIC_INPUT_PRICE=3.00
ANTHROPIC_OUTPUT_PRICE=15.00
GEMINI_INPUT_PRICE=0.75
GEMINI_OUTPUT_PRICE=3.75
