# Runtime. Production validation rejects demo fixtures, SQLite, HTTP origins, and inline jobs.
ENVIRONMENT=development
DEMO_MODE=false
BASELINE_FIXTURE_CONNECTORS=false
DATABASE_URL=postgresql+psycopg://baseline:baseline@localhost:5432/baseline
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Evaluation jobs. Use inline only for tests/local development; production requires redis.
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=baseline:evaluation-jobs

# Frontend public build-time configuration.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_EVAL_PROVIDER=openai

# Evidence connectors. SEC requires a descriptive user agent with a monitored contact address.
# Example format: Baseline Reliability security-or-ops@your-company.example
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=4
TAVILY_API_KEY=
GITHUB_TOKEN=
CONNECTOR_TIMEOUT_SECONDS=8
CONNECTOR_MAX_RESPONSE_BYTES=2000000
CONNECTOR_MAX_RETRIES=2
CONNECTOR_ALLOWED_DOMAINS=sec.gov,www.sec.gov,data.sec.gov,api.github.com,github.com,api.tavily.com

# GitHub PR checks. Keep disabled until the App/webhook setup in README is complete.
GITHUB_CHECKS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY_ALLOWLIST=owner/repository
GITHUB_APP_ID=
# Store the PEM as a secret; use literal \n escapes when the platform requires one line.
GITHUB_PRIVATE_KEY=
GITHUB_CHECK_NAME=Baseline reliability evaluation
GITHUB_EVALUATION_LIMIT=218

# Model providers (optional in development; configure the selected production evaluation provider).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash

# Approximate input/output prices per million tokens. Override as pricing changes.
OPENAI_INPUT_PRICE=2.00
OPENAI_OUTPUT_PRICE=12.00
ANTHROPIC_INPUT_PRICE=3.00
ANTHROPIC_OUTPUT_PRICE=15.00
GEMINI_INPUT_PRICE=0.75
GEMINI_OUTPUT_PRICE=3.75
